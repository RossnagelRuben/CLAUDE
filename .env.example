# Copiá a .env y completá (nunca subas .env al repo).
#
# --- Obligatorio para WhatsApp + Evolution ---
EVOLUTION_API_URL=http://127.0.0.1:8080
# Solo si tu Evolution expone rutas bajo prefijo (ej. /api): EVOLUTION_HTTP_PATH_PREFIX=/api
EVOLUTION_API_KEY=tu_apikey_evolution
EVOLUTION_INSTANCE=jarvis
WHATSAPP_ALLOWED_NUMBERS=549XXXXXXXXXX
WHATSAPP_SESSION_HOURS=8
#
# Misma clave que usás para "iniciar sesión" por WhatsApp; el panel de logout en /admin/whatsapp la pide tal cual.
AGENT_SECRET=definir_clave_segura
# Chat web en /jarvis-chat (misma IA que Telegram). Por defecto 41419180; también acepta AGENT_SECRET.
# JARVIS_WEB_CHAT_KEY=41419180
#
# Token del panel web /admin/whatsapp (números y mapa). Si no lo ponés, por defecto = AGENT_SECRET.
# ADMIN_PANEL_TOKEN=
#
# Al menos uno para el bot de texto:
# GEMINI_API_KEY=
# CLAUDE_API_KEY=
#
# Opcional: no abrir otra URL para el QR (dejar vacío = todo en /admin/whatsapp)
# QR_WEB_PUBLIC_URL=
#
# Depuración panel Evolution/QR/logout → archivo JSON lines en logs/whatsapp_debug.log
# WHATSAPP_DEBUG_LOG=1
# WHATSAPP_DEBUG_LOG_PATH=/var/log/jarvis_whatsapp_debug.log
#
# --- Jarvis Cripto (precios CMC, Jupiter swap sin custodia) ---
# Obligatorio para precios y /cripto top: clave Pro API de coinmarketcap.com
# COINMARKETCAP_API_KEY=tu_clave_aqui
# (alias equivalente: CMC_API_KEY)
# CRYPTO_CMC_CONVERT=USD,ARS
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# JUPITER_QUOTE_API_URL=https://quote-api.jup.ag/v6/quote
# JUPITER_SWAP_API_URL=https://quote-api.jup.ag/v6/swap
#
# --- WhatsApp: menú con botones (Evolution POST /message/sendButtons/{instance}) ---
# WHATSAPP_SEND_MENU_BUTTONS=1
# Por defecto: primero botones (hasta 3 por mensaje; si hay más ítems, varios mensajes). 0 = comportamiento viejo (lista primero).
# WHATSAPP_MENU_BUTTONS_FIRST=1
# Si los botones fallan, usar lista desplegable (sendList). 0 = solo botones (sin lista de respaldo).
# WHATSAPP_MENU_LIST_FALLBACK=1
# Partir en varios mensajes de 3 botones. 0 = solo los primeros 3 ítems.
# WHATSAPP_MENU_SPLIT_BUTTONS=1
# Máximo de mensajes de botones seguidos (evita spam; por defecto 5 = hasta 15 ítems).
# WHATSAPP_MENU_MAX_BUTTON_MSGS=5
# WHATSAPP_MENU_BUTTON_TITLE=Hola! Soy el asistente virtual
# WHATSAPP_MENU_BUTTON_DESCRIPTION=Atajos abajo; también podés escribir en lenguaje natural.
# WHATSAPP_MENU_BUTTON_FOOTER=Tu empresa
# id|Etiqueta (coma). Ids cripto_* → /cripto. Otros ids (buscar_web, gen_imagen, …) → texto para la IA (ver whatsapp_bridge _MENU_ID_ACTIONS).
# WHATSAPP_MENU_BUTTONS_SPEC=buscar_web|Buscar web,gen_imagen|Imagen IA,edit_imagen|Editar foto,audio_tts|Audio voz,productos_drr|Productos,calendario|Calendario,notas|Notas,cripto_ayuda|Ayuda cripto,precio_sol|Precio SOL
# Título / descripción al preguntar «qué podés hacer» (mismas opciones que WHATSAPP_MENU_BUTTONS_SPEC)
# WHATSAPP_HELP_BUTTON_TITLE=¿Qué podés hacer?
# WHATSAPP_HELP_BUTTON_DESCRIPTION=Soy Jarvis… Elegí una opción 👇
# Si sendButtons falla en Evolution, el bridge intenta sendList (lista con botón «Ver opciones»):
# WHATSAPP_LIST_OPEN_BUTTON_TEXT=Ver opciones
# WHATSAPP_LIST_SECTION_TITLE=Opciones
#
# --- Google Calendar + Google Drive (OAuth2; ver docs/GOOGLE_CALENDAR_DRIVE.md) ---
# JSON de credenciales OAuth "Cliente web" descargado desde Google Cloud Console:
# GOOGLE_OAUTH_CLIENT_SECRETS=/root/telegram-bot/google_client_secret.json
# Debe coincidir exactamente con "URI de redireccionamiento autorizado" en Google Cloud:
# GOOGLE_OAUTH_REDIRECT_URI=http://104.225.140.9/admin/google/oauth/callback
# URL base para mensajes de ayuda (sin barra final):
# JARVIS_PUBLIC_BASE_URL=http://104.225.140.9
# Opcional: sugerir esta cuenta si tenés varias sesiones de Google abiertas
# GOOGLE_OAUTH_LOGIN_HINT=rubenrossnagel@gmail.com
# Log JSONL de diagnóstico OAuth en logs/google_oauth.jsonl (1=activo)
# GOOGLE_OAUTH_DEBUG_LOG=1
# Calendario destino (casi siempre primary):
# GOOGLE_CALENDAR_ID=primary
# Zona horaria de los eventos:
# GOOGLE_CALENDAR_TIMEZONE=America/Argentina/Buenos_Aires
# Carpeta opcional en Drive (ID de carpeta de Google Drive):
# GOOGLE_DRIVE_FOLDER_ID=
