      "id": "simple-memory",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        260,
        480
      ]
    },
    {
      "parameters": {
        "modelName": "gemini-2.5-flash"
      },
      "id": "gemini-chat-model",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        500,
        120
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "JJk3gqpR0AM7pBGP",
