    {
      "parameters": {
        "toolDescription": "openfoodfacts_lookup: Busca un producto por EAN/UPC (barcode) en OpenFoodFacts y devuelve JSON con datos, ingredientes, nutrición e imágenes si existen.",
        "method": "GET",
        "url": "https://world.openfoodfacts.org/api/v2/product/{{barcode}}.json",
        "authentication": "none",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "parametersQuery": {
          "values": [
            {
              "name": "fields",
              "value": "code,product_name,brands,quantity,categories_tags,countries_tags,image_url,selected_images,nutrition_grades,ingredients_text,allergens,allergens_tags,nutriments,ecoscore_grade,packaging,labels_tags"
            }
          ]
        },
        "optimizeResponse": true,
        "responseType": "json",
        "truncateResponse": true,
        "maxLength": 4000,
        "placeholderDefinitions": {
          "values": [
            {
              "name": "barcode",
              "description": "EAN/UPC del producto, solo dígitos",
              "type": "string"
            }
          ]
        }
      },
